# === X API（必須） ===
# X Developer Portal > Keys and Tokens で取得
# https://developer.x.com
API_KEY=
API_KEY_SECRET=
BEARER_TOKEN=
ACCESS_TOKEN=
ACCESS_TOKEN_SECRET=

# === Claude API（必須） ===
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# === note.com（任意） ===
NOTE_USERNAME=              # 取得対象のnoteユーザー名（例: your_note_id）
NOTE_SESSION_TOKEN=         # 有料記事取得時のみ（通常不要）

# === 投稿設定（任意） ===
POST_TONE=casual            # 文体: casual / formal / expert
MAX_POSTS_PER_DAY=5         # 1日の最大投稿数
MIN_INTERVAL_MINUTES=60     # 投稿間隔（分）
OUTPUT_DIR=./output         # 投稿ログ保存先
